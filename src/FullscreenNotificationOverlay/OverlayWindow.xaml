<Window x:Class="FullscreenNotificationOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="112"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
  <Border x:Name="Root" CornerRadius="10" Background="#FF313338" BorderBrush="#FF1E1F22" BorderThickness="1" Padding="12" Opacity="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.42" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="42" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="28" />
      </Grid.ColumnDefinitions>
      <Border Width="36" Height="36" CornerRadius="18" Background="#5865F2" VerticalAlignment="Top">
        <TextBlock Text="D" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="10,0,8,0">
        <TextBlock x:Name="AppText" Foreground="#B5BAC1" FontSize="11" FontWeight="SemiBold" Text="DISCORD" />
        <TextBlock x:Name="TitleText" Foreground="#F2F3F5" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="BodyText" Foreground="#DBDEE1" FontSize="13" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="2" x:Name="CloseButton" Content="×" Width="24" Height="24" Click="CloseButton_Click"
              Foreground="#B5BAC1" Background="Transparent" BorderThickness="0" FontSize="18" Padding="0" VerticalAlignment="Top" />
    </Grid>
  </Border>
</Window>
